{
  "$comment": "TSchool T-Pass 服務註冊表——唯一真相來源。ops 腳本 / deploy.sh / ecosystem.config.js 讀它決定部署哪些服務；tpass-portal 讀它產生大廳卡片；tpass-auth 讀它產生發證白名單。不得在任何程式碼裡另行硬編碼服務清單、port、目錄名或網域。欄位說明見 README.md。",
  "issuer": "auth",
  "domains": { "dev": "lvh.me", "prod": "tschoolsu.org" },
  "server": {
    "$comment": "主機上的路徑約定（本機不適用——本機你想放哪都行，只要 repo 並排）。ops repo（deploy.sh / ecosystem.config.js / 這份註冊表的 clone）住 opsRoot；各服務 repo 一律是 servicesRoot/<dir>，一個服務一層，那個目錄底下不放別的東西。",
    "opsRoot": "~/tpass",
    "servicesRoot": "/home/service"
  },
  "services": [
    {
      "id": "auth",
      "name": "T-Pass SSO 發證",
      "dir": "tpass-auth",
      "subdomain": "auth",
      "port": 3000,
      "db": { "name": "t_auth", "user": "t_auth", "strategy": "migrate" },
      "enabled": true,
      "deployed": true
    },
    {
      "id": "portal",
      "name": "T-Portal 門戶",
      "dir": "tpass-portal",
      "subdomain": "portal",
      "port": 3001,
      "db": null,
      "enabled": true,
      "deployed": true
    },
    {
      "id": "form",
      "name": "T-Form 問卷",
      "dir": "tpass-form",
      "subdomain": "form",
      "port": 3002,
      "db": { "name": "t_form", "user": "t_form", "strategy": "migrate" },
      "enabled": true,
      "deployed": true,
      "portal": {
        "label": "問卷系統",
        "icon": "ClipboardList",
        "tone": "violet",
        "roles": ["all"]
      }
    },
    {
      "id": "msg",
      "name": "T-Msg 跨屆代傳",
      "dir": "tpass-cross_grade_messages",
      "subdomain": "msg",
      "port": 3003,
      "db": { "name": "t_msg", "user": "t_msg", "strategy": "migrate" },
      "enabled": true,
      "deployed": true,
      "portal": {
        "label": "跨屆代傳",
        "icon": "MessagesSquare",
        "tone": "blue",
        "roles": ["all"]
      }
    },
    {
      "id": "appeals",
      "name": "T-Appeals 申訴",
      "dir": "tpass-appeals",
      "subdomain": "appeals",
      "port": 3004,
      "db": { "name": "t_appeals", "user": "t_appeals", "strategy": "migrate" },
      "enabled": true,
      "deployed": true,
      "portal": {
        "label": "申訴系統",
        "icon": "Gavel",
        "tone": "rose",
        "roles": ["all"]
      }
    },
    {
      "id": "directory",
      "name": "T-Directory 目錄（封存）",
      "dir": "tpass-directory",
      "subdomain": "directory",
      "port": 3005,
      "db": { "name": "t_directory", "user": "t_directory", "strategy": "push" },
      "enabled": false,
      "deployed": false,
      "note": "2026-07-05 封存；port 由 3004 移至 3005 解決與 appeals 撞車"
    },
    {
      "id": "notes",
      "name": "T-Notes 學術部共編筆記",
      "dir": "tpass-notes",
      "subdomain": "notes",
      "port": 3007,
      "db": { "name": "t_notes", "user": "t_notes", "strategy": "none" },
      "enabled": true,
      "deployed": false,
      "note": "2026-08-03 納管。repo 在 Ray1020-a/tpass-notes（不在 tschoolsu 組織）。不是 Prisma，用 pg + POSTGRES_URL，schema 自理，故 strategy:none。deployed 仍為 false：主機那份還是 npm 裝的、無 pnpm-lock.yaml、目錄為 root 所有，deploy.sh 跑不動。",
      "portal": {
        "label": "共編筆記",
        "icon": "BookOpen",
        "tone": "green",
        "roles": ["all"]
      }
    },
    {
      "id": "vote",
      "name": "T-Vote 選舉",
      "dir": "tpass-vote",
      "subdomain": "vote",
      "port": 3006,
      "db": { "name": "t_vote", "user": "t_vote", "strategy": "migrate" },
      "enabled": true,
      "deployed": false,
      "portal": {
        "label": "T-Vote 選舉",
        "icon": "Vote",
        "tone": "orange",
        "roles": ["all"]
      }
    }
  ]
}
